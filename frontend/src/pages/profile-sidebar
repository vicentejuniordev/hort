.sidebar {
    width: 320px;
    height: 100vh;
    background: #ffffff;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    box-shadow: 4px 0 15px rgba(0, 0, 0, .08);
}

.sidebar-header {
    background: #00A63E;
    padding: 24px;
    text-align: center;
    color: white;
    position: relative;
}

.close-btn {
    position: absolute;
    right: 18px;
    top: 18px;
    background: none;
    border: none;
    color: white;
    font-size: 22px;
    cursor: pointer;
}

.avatar {
    width: 80px;
    height: 80px;
    border-radius: 50%;
    margin-bottom: 12px;
    border: 3px solid rgba(255, 255, 255, .3);
}

.sidebar-header h2 {
    font-size: 20px;
    margin-bottom: 5px;
}

.email {
    font-size: 13px;
    opacity: .9;
}

.premium {
    display: inline-block;
    margin-top: 12px;
    background: rgba(255, 255, 255, .2);
    padding: 8px 14px;
    border-radius: 50px;
    font-size: 12px;
}

.sidebar-content {
    flex: 1;
    padding: 16px;
}

.menu-item {
    display: flex;
    align-items: center;
    padding: 14px;
    border-radius: 12px;
    margin-bottom: 8px;
    cursor: pointer;
    transition: .2s;
}

.menu-item:hover {
    background: #f5f5f5;
}

.menu-icon {
    width: 42px;
    height: 42px;
    background: #f1f3f6;
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #6b7280;
    font-size: 18px;
}

.menu-text {
    flex: 1;
    margin-left: 12px;
}

.menu-text h4 {
    font-size: 14px;
    color: #1f2937;
    margin-bottom: 3px;
}

.menu-text p {
    font-size: 11px;
    color: #9ca3af;
}

.arrow {
    color: #9ca3af;
}

.badge {
    background: #00A63E;
    color: white;
    min-width: 18px;
    height: 18px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    font-size: 10px;
    margin-right: 10px;
}

.divider {
    height: 1px;
    background: #e5e7eb;
    margin: 20px 0;
}

.logout {
    color: #ef4444;
}

.logout .menu-icon {
    background: #fef2f2;
    color: #ef4444;
}

.sidebar-footer {
    border-top: 1px solid #e5e7eb;
    padding: 20px;
    text-align: center;
}

.sidebar-footer p {
    font-size: 12px;
    color: #6b7280;
}

.sidebar-footer span {
    font-size: 11px;
    color: #9ca3af;
}
